{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@api/*": ["./src/api/*"],
            "@modules/*": ["./src/modules/*"],
            "@assets/*": ["./src/assets/*"],
            "@/*": ["./src/*"]
        },
        "lib": ["ES2022", "DOM"],
        "target": "es2017",
        "module": "es2022",
        "moduleResolution": "bundler",
        "types": ["vite/client"]
    },
    "include": ["src"]
}
